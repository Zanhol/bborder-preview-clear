# bborder-preview docker env template (copy to .env and fill; .env NOT in git)
# MySQL root 密码：留空 = 容器空密码（与 MYSQL_ALLOW_EMPTY_PASSWORD 配套）
MYSQL_PASSWORD=
# JWT_SECRET 必须 >= 256 bit（如 >=32 个 ASCII 字符），否则后端 JwtUtil 启动抛 WeakKeyException
# 生成示例（PowerShell）：-join ((48..57)+(65..90)+(97..122) | Get-Random -Count 64 | % {[char]$_})
JWT_SECRET=
# DEMO_ENABLED=true 时开启 H5 免微信登录 + demo seed/reset（适合无微信凭据的演示环境）
DEMO_ENABLED=false
# 微信小程序凭据（code2session 登录用；不配置则微信登录不可用，可配合 DEMO_ENABLED=true 体验）
WECHAT_APPID=
WECHAT_SECRET=
WECHAT_TEMPLATE_ID=
# 管理后台口令 / 重置身份绑定密钥；留空则对应接口禁用
ADMIN_PASSWORD=
ADMIN_RESET_KEY=
WECHAT_TEMPLATE_COOK_DONE_ID=

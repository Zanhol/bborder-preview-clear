server:
  port: 8088

spring:
  datasource:
    url: jdbc:mysql://localhost:3308/family_meal?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&createDatabaseIfNotExist=true
    username: root
    password: ${MYSQL_PASSWORD:root}
    driver-class-name: com.mysql.cj.jdbc.Driver
  servlet:
    multipart:
      max-file-size: 20MB
      max-request-size: 20MB
  sql:
    init:
      mode: always
      schema-locations: classpath:db/init.sql

mybatis-plus:
  configuration:
    map-underscore-to-camel-case: true
    log-impl: org.apache.ibatis.logging.stdout.StdOutImpl
  global-config:
    db-config:
      id-type: auto

app:
  jwt:
    # 生产务必通过环境变量注入，且 >= 256 bit，否则 JwtUtil 启动抛 WeakKeyException
    secret: ${JWT_SECRET:change-me-to-a-strong-secret-of-at-least-32-bytes}
    expiration: 86400000
  upload:
    path: ./uploads
  wechat:
    # ⚠️ 微信凭据：仅限本地测试使用，禁止提交进 git / 公开发布。
    # 上线前请在微信公众平台重新申请 AppSecret，并通过环境变量注入，勿复制本文件到 application.yml。
    app-id: ${WECHAT_APPID:}
    secret: ${WECHAT_SECRET:}
    template-id: ${WECHAT_TEMPLATE_ID:}
    miniprogram-state: trial
  admin:
    # 重置身份绑定管理密钥 / 管理后台口令；未配置则对应接口禁用
    reset-key: ${ADMIN_RESET_KEY:}
    password: ${ADMIN_PASSWORD:}
  demo:
    # 纯净演示版：H5 免密登录 + seed/reset（管理后台需要）
    # seed/reset 与 login 一致，须带请求头 X-Demo-Key
    enabled: ${DEMO_ENABLED:false}
    key: ${DEMO_KEY:demo}
